<Window x:Class="UP1.Windows.FrozenAppealWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Апелляция — Read and Write"
        Height="460" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#2D2D2D">

    <Grid Margin="30">
        <StackPanel>

            <TextBlock Text="⚠️ Аккаунт заморожен"
                       FontSize="22" FontWeight="Bold" Foreground="#F44336"
                       HorizontalAlignment="Center" Margin="0,0,0,14"/>

            <TextBlock x:Name="tbStatusText"
                       FontSize="13" Foreground="#AAAAAA"
                       TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" Margin="0,0,0,22"/>

            <!-- Форма подачи апелляции -->
            <StackPanel x:Name="panelForm">
                <TextBlock Text="Опишите ситуацию:" Foreground="#AAAAAA"
                           FontSize="13" Margin="0,0,0,6"/>
                <TextBox x:Name="txtReason"
                         Height="110" FontSize="13"
                         Background="#3C3C3C" Foreground="White" BorderBrush="#555555"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"/>
                <Button Content="Подать апелляцию"
                        Click="BtnSubmit_Click"
                        Height="44" FontSize="15"
                        Background="#FF9800" Foreground="White" Margin="0,0,0,10"/>
            </StackPanel>

            <!-- Информация об уже поданной апелляции -->
            <Border x:Name="panelExisting" Visibility="Collapsed"
                    Background="#3A3A3A" CornerRadius="7" Padding="14" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="📋 Апелляция на рассмотрении"
                               Foreground="#FF9800" FontWeight="Bold" FontSize="14"
                               Margin="0,0,0,7"/>
                    <TextBlock x:Name="tbAppealReason" Foreground="#CCCCCC"
                               FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock x:Name="tbAppealDate" Foreground="#888888"
                               FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Button Content="← Вернуться к входу"
                    Click="BtnBack_Click"
                    Height="38" FontSize="13"
                    Background="Transparent" Foreground="#2196F3" BorderBrush="#2196F3"/>
        </StackPanel>
    </Grid>
</Window>
