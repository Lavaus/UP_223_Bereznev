<Window x:Class="UP1.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация — Read and Write"
        Height="635" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#2D2D2D">

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Read and Write"
                       FontSize="22" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Регистрация"
                       FontSize="15" Foreground="#AAAAAA"
                       HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Отображаемое имя" Foreground="#AAAAAA" Margin="0,0,0,5"/>
            <TextBox x:Name="txtDisplayName" Height="35" FontSize="14" Margin="0,0,0,12"
                     Background="#3C3C3C" Foreground="White" BorderBrush="#555555"/>

            <TextBlock Text="Логин" Foreground="#AAAAAA" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin" Height="35" FontSize="14" Margin="0,0,0,12"
                     Background="#3C3C3C" Foreground="White" BorderBrush="#555555"/>

            <TextBlock Text="Email" Foreground="#AAAAAA" Margin="0,0,0,5"/>
            <TextBox x:Name="txtEmail" Height="35" FontSize="14" Margin="0,0,0,12"
                     Background="#3C3C3C" Foreground="White" BorderBrush="#555555"/>

            <TextBlock Text="Пароль" Foreground="#AAAAAA" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="35" FontSize="14" Margin="0,0,0,12"
                         Background="#3C3C3C" Foreground="White" BorderBrush="#555555"/>

            <TextBlock Text="Повтор пароля" Foreground="#AAAAAA" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPasswordConfirm" Height="35" FontSize="14" Margin="0,0,0,22"
                         Background="#3C3C3C" Foreground="White" BorderBrush="#555555"/>

            <Button Content="Зарегистрироваться"
                    Click="BtnRegister_Click"
                    Height="45" FontSize="16" Margin="0,0,0,10"
                    Background="#4CAF50" Foreground="White"/>

            <Button Content="Уже есть аккаунт? Войти"
                    Click="BtnBackToLogin_Click"
                    Height="40" FontSize="14"
                    Background="Transparent" Foreground="#2196F3" BorderBrush="#2196F3"/>
        </StackPanel>
    </Grid>
</Window>
