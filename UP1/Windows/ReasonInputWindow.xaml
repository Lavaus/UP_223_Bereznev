<Window x:Class="UP1.Windows.ReasonInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Жалоба"
        Width="420" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF2E544C">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblPrompt" Grid.Row="0"
                   Text="Укажите причину жалобы:"
                   Foreground="White" FontSize="14"
                   Margin="0,0,0,10"/>

        <TextBox x:Name="txtReason" Grid.Row="1"
                 Background="#FF2E544C" Foreground="White"
                 BorderBrush="#555" FontSize="13"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,15"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отправить" Width="100" Height="34"
                    Background="#4CAF50" Foreground="White" FontSize="13"
                    Margin="0,0,10,0" Click="BtnOk_Click"/>
            <Button Content="Отмена" Width="80" Height="34"
                    Background="#FFC86DD8" Foreground="White" FontSize="13"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
