<Window x:Class="UP1.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Read and Write" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#FF0D5646"
        WindowStyle="None"
        AllowsTransparency="False">

    <Grid>

        <Grid Width="70" HorizontalAlignment="Left" Background="#FF153730">
            <StackPanel Margin="0,20,0,0">
   
                <TextBlock Text="RW" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#FF99BDB5"/>

                <Button x:Name="btnCatalog" Height="60" Click="BtnCatalog_Click" ToolTip="Каталог книг">
                    <TextBlock Text="СП" FontSize="24"/>
                </Button>

                <Button x:Name="btnLists" Height="60" Click="BtnLists_Click" ToolTip="Мои списки">
                    <TextBlock Text="МОИ" FontSize="24"/>
                </Button>

                <Button x:Name="btnAuthor" Height="60" Click="BtnAuthor_Click" ToolTip="Страница автора" Visibility="Collapsed">
                    <TextBlock Text="АВТ" FontSize="24"/>
                </Button>

                <Button x:Name="btnAdmin" Height="60" Click="BtnAdmin_Click" ToolTip="Администрирование" Visibility="Collapsed">
                    <TextBlock Text="АДМ" FontSize="24"/>
                </Button>

                <Button x:Name="btnFreezeWarning" Height="60" Click="BtnFreezeWarning_Click" 
                     ToolTip="Аккаунт заморожен!" Background="#FFC86DD8" Visibility="Collapsed">
                    <TextBlock Text="БАН" FontSize="28"/>
                </Button>

                <Button x:Name="btnProfile" Height="60" Click="BtnProfile_Click" ToolTip="Профиль">
                    <TextBlock Text="ПРОФ" FontSize="24"/>
                </Button>
            </StackPanel>


            <Button Content="⏻" 
                    Click="BtnLogout_Click"
                    Width="50" Height="50"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                    Background="#FFC86DD8" Foreground="Black" FontSize="20"/>
        </Grid>


        <Grid x:Name="MainContent" Margin="70,0,0,0" Background="#FF2E544C">
            <TextBlock x:Name="tbPageTitle" 
                       Text="Каталог книг" 
                       FontSize="28" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20"/>

          
            <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" Margin="0,70,0,0"/>
        </Grid>
    </Grid>
</Window>