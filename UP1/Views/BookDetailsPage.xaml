<Page x:Class="UP1.Views.BookDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="650"
      d:DesignWidth="1100"
      Title="BookDetailsPage">

    <Page.Resources>

        <!-- Стиль карточки отзыва -->
        <Style x:Key="ReviewCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E3B33"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>


        <DataTemplate x:Key="ReviewItemTemplate">
            <Border Style="{StaticResource ReviewCardStyle}">
                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Users.DisplayName}"
                                   FontWeight="Bold" Foreground="White"
                                   FontSize="14" Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Foreground="Gold" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,10,0">
                            <Run Text="⭐ "/>
                            <Run Text="{Binding Rating}"/>
                            <Run Text="/10"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Created, StringFormat=dd.MM.yyyy}"
                                   Foreground="Gray" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ReviewText}"
                               Foreground="#CCCCCC" FontSize="13"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Button Content="Пожаловаться на отзыв"
                            HorizontalAlignment="Right"
                            Padding="8,4" FontSize="11"
                            Background="#555555" Foreground="White"
                            Tag="{Binding}"
                            Click="BtnReportReview_Click"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Page.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

  
        <StackPanel Grid.Column="0" Margin="0,0,30,0">
            <Border Width="250" Height="350" Background="#FF2E544C" CornerRadius="10" HorizontalAlignment="Center">
                <Image x:Name="tbCover" Height="350" Width="250" Stretch="UniformToFill"/>
            </Border>

            <TextBlock x:Name="tbTitle" FontSize="22" FontWeight="Bold" Foreground="White"
                       TextWrapping="Wrap" Margin="0,20,0,5" TextAlignment="Center"/>
            <TextBlock x:Name="tbAuthor" FontSize="16" Foreground="#AAAAAA"
                       TextAlignment="Center" Margin="0,0,0,15"/>
            <TextBlock x:Name="tbRating" FontSize="18" Foreground="Gold"
                       TextAlignment="Center" Margin="0,0,0,20"/>

            <Button Content="Читать книгу" Height="50" FontSize="16"
                    Background="#4CAF50" Foreground="White" Margin="0,10"
                    Click="BtnRead_Click"/>

  
            <TextBlock Text="Добавить в список:" Foreground="#AAAAAA"
                       FontSize="13" Margin="0,10,0,5"/>
            <ComboBox x:Name="cmbReadingList" Height="35" FontSize="13"
                      Background="#3C3C3C" Foreground="Black">
                <ComboBoxItem Content="— не выбрано —" IsSelected="True"/>
                <ComboBoxItem Content="В планах"/>
                <ComboBoxItem Content="Читаю"/>
                <ComboBoxItem Content="Прочитано"/>
                <ComboBoxItem Content="Заброшено"/>
            </ComboBox>
            <Button x:Name="btnAddToList" Content="Сохранить" Height="38"
                    Background="#2196F3" Foreground="White" Margin="0,6,0,0"
                    FontSize="13" Click="BtnAddToList_Click"/>

            <Button x:Name="btnFreezeBook" Content="Заморозить книгу" Height="45" Margin="0,12,0,0"
                    Background="#F44336" Foreground="White"
                    Visibility="Collapsed" Click="BtnFreezeBook_Click"/>
        </StackPanel>

 
        <StackPanel Grid.Column="1">
            <TextBlock Text="Описание" FontSize="18" FontWeight="Bold"
                       Foreground="White" Margin="0,0,0,10"/>
            <TextBlock x:Name="tbDescription" TextWrapping="Wrap" Foreground="#DDDDDD"
                       FontSize="14" Margin="0,0,0,25" Height="100"/>

            <TextBlock Text="Оставить отзыв" FontSize="18" FontWeight="Bold"
                       Foreground="White" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <ComboBox x:Name="cmbRating" Width="140" Height="35"
                          SelectionChanged="CmbRating_SelectionChanged">
                    <ComboBoxItem Content="10 - Прекрасно" IsSelected="True"/>
                    <ComboBoxItem Content="9 - Отлично"/>
                    <ComboBoxItem Content="8 - Хорош"/>
                    <ComboBoxItem Content="7 - А нечё так"/>
                    <ComboBoxItem Content="6 - Нормально"/>
                    <ComboBoxItem Content="5 - Для нормисов"/>
                    <ComboBoxItem Content="4 - Неплохо"/>
                    <ComboBoxItem Content="3 - Плохо"/>
                    <ComboBoxItem Content="2 - Ужасно"/>
                    <ComboBoxItem Content="1 - Читать невозможно"/>
                </ComboBox>
                <Button Content="Опубликовать отзыв" Margin="15,0,0,0" Padding="15,8"
                        Background="#4CAF50" Foreground="Black"
                        Click="BtnPublishReview_Click"/>
                <Button Content="Пожаловаться на книгу" Margin="15,0,0,0" Height="35"
                        Background="#FFC86DD8" Foreground="Black"
                        Click="BtnReportBook_Click"/>
            </StackPanel>

            <TextBox x:Name="txtReviewText" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                     Background="#FF4B887B" Foreground="Black" BorderBrush="#555"
                     Margin="0,0,0,20"/>
            <TextBlock Text="Отзывы читателей" FontSize="18" FontWeight="Bold"
                       Foreground="Black" Margin="0,0,0,10"/>

            <TextBlock x:Name="tbNoReviews"
                       Text="Отзывов пока нет. Будьте первым!"
                       Foreground="Gray" FontSize="14"
                       Margin="0,10,0,0" Visibility="Collapsed"/>

            <ScrollViewer Height="280" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="reviewsControl"
                              ItemTemplate="{StaticResource ReviewItemTemplate}"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Page>
