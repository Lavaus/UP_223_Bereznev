<Page x:Class="UP1.Views.BookCatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="650"
      d:DesignWidth="1100"
      Title="BookCatalogPage">

    <Page.Resources>
        <Style x:Key="BookCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E3B33"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="164"/>
            <Setter Property="Height" Value="244"/>
        </Style>

        <DataTemplate x:Key="BookCardTemplate">
            <Border Style="{StaticResource BookCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Row="0"
                           Source="{Binding CoverPath}"
                           Stretch="UniformToFill"/>

                    <StackPanel Grid.Row="1" Margin="6,4">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="White" FontWeight="Bold"
                                   FontSize="12" TextWrapping="Wrap"
                                   MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Users.DisplayName}"
                                   Foreground="#AAAAAA" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Row="2"
                            Content="Подробнее"
                            Height="28" FontSize="11"
                            Background="#FF2E544C" Foreground="White"
                            Margin="6,0,6,6"
                            Tag="{Binding}"
                            Click="BtnBookCard_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
    
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

 
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

      
            <StackPanel Grid.Column="0" Orientation="Horizontal">
 
                <TextBox x:Name="txtSearch" Width="280" Height="35" Margin="0,0,12,0"
                         Background="#FF2E544C" Foreground="White" BorderBrush="#555"
                         TextChanged="TxtSearch_TextChanged"/>

                <ComboBox x:Name="cmbGenre" Width="180" Height="35" Margin="0,0,12,0"
                          SelectionChanged="CmbGenre_SelectionChanged"/>

                <ComboBox x:Name="cmbSort" Width="160" Height="35"
                          SelectionChanged="CmbSort_SelectionChanged">
                    <ComboBoxItem Content="По названию" IsSelected="True"/>
                    <ComboBoxItem Content="По автору"/>
                </ComboBox>
            </StackPanel>

      
            <Button Grid.Column="1" Content="Обновить" Height="35" Padding="15,0"
                    Click="BtnRefresh_Click"/>
        </Grid>

   
        <TextBlock x:Name="tbEmpty" Grid.Row="1"
                   Text="Книги не найдены."
                   Foreground="Gray" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="booksControl"
                          ItemTemplate="{StaticResource BookCardTemplate}">
                <ItemsControl.ItemsPanel>
   
                    <ItemsPanelTemplate>
                        <WrapPanel Margin="0" HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
