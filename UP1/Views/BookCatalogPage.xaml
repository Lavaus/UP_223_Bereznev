<Page x:Class="UP1.Views.BookCatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="BookCatalogPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Фильтры -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox x:Name="txtSearch" Width="300" Height="35" Margin="0,0,15,0" 
                     TextChanged="TxtSearch_TextChanged" Background="#FF99BDB5"/>

            <ComboBox x:Name="cmbSort" Width="200" Height="35" Margin="0,0,15,0"
                      SelectionChanged="CmbSort_SelectionChanged"/>

            <Button Content="Обновить" Height="35" Margin="10,0,0,0" Click="BtnRefresh_Click"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid x:Name="dgBooks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#FF99BDB5" Foreground="White" RowBackground="#2D2D2D"
                  AlternatingRowBackground="#333333" GridLinesVisibility="None"
                  MouseDoubleClick="DgBooks_MouseDoubleClick"
                  RowHeight="80">

            <DataGrid.Columns>
                <!-- Обложка -->
                <DataGridTemplateColumn Header="Обложка" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding CoverPath}" 
                                   Stretch="UniformToFill" 
                                   Margin="5"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="250"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Users.DisplayName}" Width="180"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding GenreString}" Width="150"/>
                <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>