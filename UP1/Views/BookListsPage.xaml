<Page x:Class="UP1.Views.BookListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="1100"
      Title="BookListsPage">

    <Page.Resources>


        <DataTemplate x:Key="BookCardTemplate">
            <Border Width="170" Height="260"
                    Background="#2D2D30"
                    CornerRadius="10"
                    Margin="12"
                    Cursor="Hand"
                    Tag="{Binding}">

                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Button Tag="{Binding}"
                        Click="BtnBookCard_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="160"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Width="120" Height="160"
                                Background="#3C3C3C"
                                CornerRadius="6"
                                HorizontalAlignment="Center"
                                ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding CoverPath}"
                                       Stretch="UniformToFill"/>
                                <TextBlock Text="" FontSize="48"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Title}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="0,6,0,2"/>

                        <TextBlock Grid.Row="2"
                                   Text="{Binding Users.DisplayName}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#AAAAAA"
                                   VerticalAlignment="Top"/>
                    </Grid>
                </Button>
            </Border>
        </DataTemplate>

    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnPlan"     Content="В планах"  Width="140" Height="40" Margin="5" Click="BtnPlan_Click"/>
                <Button x:Name="btnReading"  Content="Читаю"     Width="140" Height="40" Margin="5" Click="BtnReading_Click"/>
                <Button x:Name="btnFinished" Content="Прочитано" Width="140" Height="40" Margin="5" Click="BtnFinished_Click"/>
                <Button x:Name="btnDropped"  Content="Заброшено" Width="140" Height="40" Margin="5" Click="BtnDropped_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox x:Name="txtSearchLists" Width="250" Height="35" Margin="0,0,10,0"
                         Background="#FF2E544C" Foreground="White"
                         TextChanged="TxtSearchLists_TextChanged"/>
                <ComboBox x:Name="cmbSortLists" Width="160" Height="35"
                          SelectionChanged="CmbSortLists_SelectionChanged">
                    <ComboBoxItem Content="По названию" IsSelected="True"/>
                    <ComboBoxItem Content="По автору"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="tbEmpty" Grid.Row="1"
                   Text="В этом списке пока нет книг."
                   Foreground="Gray" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>


        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="booksControl"
                          ItemTemplate="{StaticResource BookCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" Margin="10" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
