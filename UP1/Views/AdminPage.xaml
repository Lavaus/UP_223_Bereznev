<Page x:Class="UP1.Views.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AdminPage">

    <Grid Margin="20">
        <TabControl Background="#2D2D2D" BorderBrush="#3C3C3C">

            <!-- ==================== ПОЛЬЗОВАТЕЛИ ==================== -->
            <TabItem Header="👥 Пользователи">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FF3A7EA9"/>
                        <GradientStop Color="#FF99BDB5" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgUsers" Grid.Row="0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#FF2E544C" Foreground="White"
                              RowBackground="#1E3B33" AlternatingRowBackground="#253F37"
                              GridLinesVisibility="None" SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF153730"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"        Binding="{Binding UserID}"       Width="50"/>
                            <DataGridTextColumn Header="Имя"       Binding="{Binding DisplayName}"  Width="200"/>
                            <DataGridTextColumn Header="Логин"     Binding="{Binding Login}"         Width="140"/>
                            <DataGridTextColumn Header="Email"     Binding="{Binding Email}"         Width="200"/>
                            <DataGridTextColumn Header="Роль"      Binding="{Binding Role.RoleName}" Width="120"/>
                            <DataGridTextColumn Header="Заморожен" Binding="{Binding IsFrozen}"      Width="90"/>
                            <DataGridTextColumn Header="Дата рег." Binding="{Binding Created, StringFormat=dd.MM.yyyy}" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="❄️  Заморозить"    Width="160" Height="38" Margin="0,0,8,0"
                                Background="#FFC86DD8" Foreground="White"  Click="BtnFreezeUser_Click"/>
                        <Button Content="✅  Разморозить"   Width="160" Height="38" Margin="0,0,8,0"
                                Background="#4CAF50"   Foreground="White"  Click="BtnUnfreezeUser_Click"/>
                        <Button Content="🔑  Сменить роль" Width="160" Height="38"
                                Background="#FF99BDB5" Foreground="Black"  Click="BtnChangeRole_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ==================== ЖАЛОБЫ ==================== -->
            <!-- Complain не имеет поля Status в БД, поэтому показываем все жалобы.
                 Действие "Заморозить автора" замораживает пользователя напрямую через Users.IsFrozen -->
            <TabItem Header="🚩 Жалобы">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FF3A7EA9"/>
                        <GradientStop Color="#FF99BDB5" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgComplaints" Grid.Row="0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#FF2E544C" Foreground="White"
                              RowBackground="#1E3B33" AlternatingRowBackground="#253F37"
                              GridLinesVisibility="None" SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF153730"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"         Binding="{Binding ComplainID}"         Width="50"/>
                            <DataGridTextColumn Header="Жалобщик"   Binding="{Binding Users.DisplayName}"  Width="160"/>
                            <DataGridTextColumn Header="Книга"      Binding="{Binding Book.Title}"         Width="230"/>
                            <DataGridTextColumn Header="Причина"    Binding="{Binding Reason}"             Width="300"/>
                            <DataGridTextColumn Header="Дата"       Binding="{Binding Created, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="❄️  Заморозить автора книги" Width="210" Height="38" Margin="0,0,8,0"
                                Background="#FFC86DD8" Foreground="White" Click="BtnFreezeBookAuthor_Click"/>
                        <Button Content="📖  Заморозить книгу"        Width="185" Height="38" Margin="0,0,8,0"
                                Background="#FF7043"   Foreground="White" Click="BtnFreezeBook_Click"/>
                        <TextBlock Foreground="#888888" FontSize="11" VerticalAlignment="Center"
                                   Margin="10,0" TextWrapping="Wrap" Width="260"
                                   Text="Выберите жалобу и нажмите действие. Заморозка книги скрывает её из каталога."/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ==================== АПЕЛЛЯЦИИ ==================== -->
            <TabItem Header="📩 Апелляции">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FF3A7EA9"/>
                        <GradientStop Color="#FF99BDB5" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgAppeals" Grid.Row="0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#FF2E544C" Foreground="White"
                              RowBackground="#1E3B33" AlternatingRowBackground="#253F37"
                              GridLinesVisibility="None" SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF153730"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"           Binding="{Binding UnfreezerequestID}" Width="50"/>
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding Users.DisplayName}" Width="180"/>
                            <DataGridTextColumn Header="Логин"        Binding="{Binding Users.Login}"       Width="130"/>
                            <DataGridTextColumn Header="Обоснование"  Binding="{Binding Reason}"            Width="330"/>
                            <DataGridTextColumn Header="Статус"       Binding="{Binding Status}"            Width="90"/>
                            <DataGridTextColumn Header="Дата"         Binding="{Binding Created, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="✅  Принять (разморозить)" Width="210" Height="38" Margin="0,0,8,0"
                                Background="#4CAF50"   Foreground="White" Click="BtnApproveAppeal_Click"/>
                        <Button Content="❌  Отклонить апелляцию"   Width="210" Height="38"
                                Background="#FFC86DD8" Foreground="White" Click="BtnRejectAppeal_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ==================== ЗАЯВКИ НА АВТОРА ==================== -->
            <TabItem Header="📋 Заявки на автора">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FF3A7EA9"/>
                        <GradientStop Color="#FF99BDB5" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgRoleRequests" Grid.Row="0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#FF2E544C" Foreground="White"
                              RowBackground="#1E3B33" AlternatingRowBackground="#253F37"
                              GridLinesVisibility="None" SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF153730"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"           Binding="{Binding RoleRequestID}"     Width="50"/>
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding Users.DisplayName}" Width="200"/>
                            <DataGridTextColumn Header="Логин"        Binding="{Binding Users.Login}"       Width="150"/>
                            <DataGridTextColumn Header="Статус"       Binding="{Binding Status}"            Width="120"/>
                            <DataGridTextColumn Header="Дата"         Binding="{Binding Created, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="✅  Принять"   Width="140" Height="38" Margin="0,0,8,0"
                                Background="#4CAF50"   Foreground="White" Click="BtnApproveRole_Click"/>
                        <Button Content="❌  Отклонить" Width="140" Height="38"
                                Background="#FFC86DD8" Foreground="White" Click="BtnRejectRole_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
