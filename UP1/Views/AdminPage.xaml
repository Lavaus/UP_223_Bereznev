<Page x:Class="UP1.Views.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AdminPage">

    <Grid Margin="20">
        <TabControl Background="#2D2D2D" BorderBrush="#3C3C3C">

            <!-- Пользователи -->
            <TabItem Header="👥 Пользователи">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FF3A7EA9"/>
                        <GradientStop Color="#FF99BDB5" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <Grid>
                    <DataGrid x:Name="dgUsers" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#FF2E544C" Foreground="Black" RowBackground="Black"
                              AlternatingRowBackground="#333333" GridLinesVisibility="None" 
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding UserID}" Width="60"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding DisplayName}" Width="200"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding Role.RoleName}" Width="120"/>
                            <DataGridTextColumn Header="Заморожен" Binding="{Binding IsFrozen}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,10" Orientation="Horizontal">
                        <Button Content="Сменить роль" Width="160" Height="35" Margin="5" Click="BtnChangeRole_Click" Background="#FF99BDB5"/>
                        <Button Content="Сбросить пароль" Width="160" Height="35" Margin="5" Click="BtnResetPassword_Click" Background="#FF99BDB5"/>
                        <Button Content="В бан" Width="160" Height="35" Margin="5" Background="#FFC86DD8" Click="BtnFreezeUser_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Жалобы -->
            <TabItem Header="🚩 Жалобы">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FF3A7EA9"/>
                        <GradientStop Color="#FF99BDB5" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <DataGrid x:Name="dgComplaints" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#FF2E544C" Foreground="Black" RowBackground="Black">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ComplainID}" Width="70"/>
                        <DataGridTextColumn Header="Книга" Binding="{Binding Book.Title}" Width="250"/>
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding Users.DisplayName}" Width="180"/>
                        <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="300"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="📋 Заявки на автора">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FF3A7EA9"/>
                        <GradientStop Color="#FF99BDB5" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="60*"/>
                        <ColumnDefinition Width="67*"/>
                        <ColumnDefinition Width="207*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="dgRoleRequests" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#FF2E544C" Foreground="Black" RowBackground="Black" Grid.ColumnSpan="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding RoleRequestID}" Width="60"/>
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding Users.DisplayName}" Width="200"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Users.Login}" Width="150"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Created, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Orientation="Horizontal" Grid.Column="3">
                        <Button Content="Принять" Width="120" Height="40" Margin="5" Background="#FF99BDB5" Click="BtnApproveRole_Click"/>
                        <Button Content="Отклонить" Width="120" Height="40" Margin="5" Background="#FFC86DD8" Click="BtnRejectRole_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

    </Grid>
</Page>